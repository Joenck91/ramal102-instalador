# ============================================================
# booZapp — modelo de configuracao
#
# Copie para .env e preencha. NUNCA versione o .env preenchido.
# Gere os segredos na propria maquina:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ============================================================

# --- Evolution API ---
# Este valor vale SO no modo dev, quando o servidor roda no host e fala
# com a Evolution pela porta publicada. Dentro do compose ele e
# sobrescrito por http://evolution:8080, que e o nome do servico.
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-por-uma-chave-forte

# URL que a Evolution usa para ENTREGAR os webhooks no booZapp.
# A Evolution roda em container: "localhost" ali dentro seria ela mesma.
PUBLIC_WEBHOOK_URL=http://host.docker.internal:3000/webhook/evolution

# --- Banco (container inbox_postgres) ---
INBOX_DB_PASSWORD=gere-uma-senha-aleatoria
# Usada apenas pelo modo de desenvolvimento, que fala com o banco pela
# porta publicada no host. No container, o compose sobrescreve este valor
# apontando para o nome do servico.
DATABASE_URL=postgresql://inbox:gere-uma-senha-aleatoria@localhost:5433/inbox?schema=public

# --- Acesso ---
APP_PASSWORD=troque-esta-senha
JWT_SECRET=gere-64-caracteres-hexadecimais

# --- Backend ---
PORT=3000
# Vale so no modo dev; no container o compose forca "production".
NODE_ENV=development

# Origem do frontend liberada no CORS. Vale so no modo dev: no container o
# frontend e servido na mesma origem e o CORS nem e registrado.
WEB_ORIGIN=http://localhost:5173

# --- Backup diario (container boozapp_backup) ---
# Onde as copias sao gravadas. Caminho do HOST, relativo a esta pasta ou
# absoluto. Aponte para uma pasta sincronizada (OneDrive, Drive) se
# quiser sobreviver a perda do disco. Ver "Backup" no README.
BACKUP_DIR=./backups
# Hora do dia, 00 a 23, no fuso de Sao Paulo.
BACKUP_HORA=03
# Banco da Evolution, que tambem entra na copia.
EVOLUTION_DB_HOST=evolution-postgres
EVOLUTION_DB_PORT=5432
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=a-senha-do-postgres-da-evolution
EVOLUTION_DB_NAME=evolution

# --- Primeira conta (usado so na primeira subida) ---
# Quem vai entrar da primeira vez, com a APP_PASSWORD acima. Depois que
# a conta existe, a senha que vale e a do banco.
ADMIN_EMAIL=voce@suaempresa.com.br
ADMIN_NAME=Seu Nome
ACCOUNT_NAME=Sua Empresa

# --- Plano ---
# "gratis" ou "pago". Sem esta linha, e gratis.
#
# HOJE o instalador escreve "pago", porque quem esta instalando sao
# colegas de trabalho. No dia em que comecar a venda, esta linha passa a
# ser escrita pela chave que o cliente recebe — e nao pelo instalador.
#
# O que muda no gratis: conversas fixadas (5), mensagens fixadas por
# conversa (3), respostas rapidas (50, de 512 caracteres e sem arquivo).
# E ficam de fora notas internas, Alerta de Espera, agendar retorno e
# disparo, acoes em lote, verificador e mais de uma pessoa na equipe.
RAMAL_PLANO=pago

# A maquina de quem DESENVOLVE o Ramal, e nao a de quem usa. Com "1"
# aparece em Configuracoes uma aba que alterna entre gratis e pago sem
# reiniciar, para ver as duas telas. Deixe "0".
RAMAL_MODO_DEV=0

# --- De onde vem o Ramal ---
# Com esta linha, a instalacao BAIXA o Ramal ja montado (menos de um
# minuto). Sem ela, a maquina monta tudo do zero (5 a 15 minutos). As
# duas levam ao mesmo lugar; a primeira so e muito mais rapida.
#
# Se o download falhar — sem internet, imagem fora do ar, maquina de
# outra arquitetura —, o instalador monta na hora sozinho. Entao deixar
# ligado nao arrisca nada: no pior caso a instalacao demora o que
# demorava antes.
#
# O endereco e todo minusculo de proposito: o GitHub mostra "Joenck91",
# mas repositorio de imagem nao aceita maiuscula, e escrever assim da um
# "nao encontrado" que parece outra coisa.
RAMAL_IMAGEM=ghcr.io/joenck91/ramal102:latest
